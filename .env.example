# ──────────────────────────────────────────────────────────────────────────
# Kiosk Main Server — environment configuration
# Copy this file to `.env` and adjust as needed. All values have safe defaults
# in app/core/config.py, so the server also runs with no .env present.
# ──────────────────────────────────────────────────────────────────────────

# --- HTTP server ---
KIOSK_HOST=0.0.0.0
KIOSK_PORT=8080

# --- CORS (comma-separated origins, or * for all) ---
KIOSK_CORS_ORIGINS=*

# --- External VLM Server (PORT 8000, runs on the Nvidia Jetson Thor) ---
# Only a *client* to this server lives here; the VLM itself is NOT implemented.
# 키오스크는 구조화된 결과(action+tts_message)를 주는 /analyze 를 사용한다.
KIOSK_VLM_BASE_URL=http://172.16.0.62:8000
KIOSK_VLM_ANALYZE_PATH=/analyze
# /analyze 가 Jetson 파일시스템에서 읽을 프레임 폴더(절대 경로).
# 하드웨어 서버가 30fps 프레임을 기록하는 공유 디렉터리를 가리켜야 한다.
KIOSK_VLM_FRAME_DIR=/home/ds/Desktop/vlm_test/frames_448_30
# VLM+LLM 2단계 추론은 수 초 소요 + 워커 큐 대기까지 고려해 넉넉히.
KIOSK_VLM_TIMEOUT_SECONDS=60.0
# When true, never call the network; always use the built-in offline stub.
KIOSK_VLM_FORCE_MOCK=false

# --- Shared Dir (30fps frames written by the Hardware Server, PORT 8081) ---
KIOSK_SHARED_DIR=./shared_dir
KIOSK_FRAME_GLOB=frame_*.jpg

# --- Shared DB ---
# Data source: "mock" (JSON fixtures, no DB needed) or "mysql" (real MySQL on
# the Jetson). If "mysql" is set but the DB is unreachable, the server logs a
# warning and falls back to "mock" automatically.
KIOSK_REPOSITORY=mock

# MySQL connection — only used when KIOSK_REPOSITORY=mysql.
KIOSK_DB_HOST=127.0.0.1
KIOSK_DB_PORT=3306
KIOSK_DB_USER=root
KIOSK_DB_PASSWORD=
KIOSK_DB_NAME=kiosk
KIOSK_DB_CHARSET=utf8mb4
KIOSK_DB_CONNECT_TIMEOUT=5

# Static labels for fields the ERD has no column for (temp-humid / watch).
KIOSK_SITE_LOCATION=경기도 고양시
KIOSK_WATCH_REGION=고양시사업장

# --- TTS (Edge TTS) ---
KIOSK_TTS_VOICE=ko-KR-SunHiNeural
KIOSK_TTS_OUTPUT_DIR=./tts_out
# When true, synthesize real audio bytes via edge-tts; when false, stub only.
KIOSK_TTS_ENABLED=true

# --- Warning light (경광등) count -> control-signal thresholds ---
# 0~2: 소등 / 3~5: 관심(초록) / 6~8: 주의(노랑) / 9~11: 경고(빨강) / 12+: 위험(순차)
KIOSK_LIGHT_INTEREST_THRESHOLD=3
KIOSK_LIGHT_CAUTION_THRESHOLD=6
KIOSK_LIGHT_WARNING_THRESHOLD=9
KIOSK_LIGHT_DANGER_THRESHOLD=12

# --- Logging ---
KIOSK_LOG_LEVEL=INFO
