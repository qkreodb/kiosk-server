# ──────────────────────────────────────────────────────────────────────────
# Kiosk Main Server — environment configuration
# Copy this file to `.env` and adjust as needed. All values have safe defaults
# in app/core/config.py, so the server also runs with no .env present.
# ──────────────────────────────────────────────────────────────────────────

# --- HTTP server ---
KIOSK_HOST=0.0.0.0
KIOSK_PORT=8080

# --- CORS (comma-separated origins, or * for all) ---
KIOSK_CORS_ORIGINS=*

# --- External VLM Server (PORT 8000, runs on the Nvidia Jetson Thor) ---
# Only a *client* to this server lives here; the VLM itself is NOT implemented.
# Request: {"dir_path": "string"} / Response: action(카운트), tts_message(TTS 알림)
KIOSK_VLM_BASE_URL=http://172.16.0.62:8000
KIOSK_VLM_ANALYZE_PATH=/analyze
# /analyze 가 Jetson 파일시스템에서 읽을 프레임 폴더(절대 경로).
# 하드웨어 서버가 30fps 프레임을 기록하는 공유 디렉터리를 가리켜야 한다.
KIOSK_VLM_FRAME_DIR=/home/ds/Desktop/frames
# VLM+LLM 2단계 추론은 수 초 소요 + 워커 큐 대기까지 고려해 넉넉히.
KIOSK_VLM_TIMEOUT_SECONDS=60.0

# --- Shared Dir (30fps frames written by the Hardware Server, PORT 8081) ---
# kiosk-hardware 의 rtsp_frame.py 가 기록하는 프레임 폴더.
KIOSK_SHARED_DIR=../kiosk-hardware/frames
KIOSK_FRAME_GLOB=frame_*.jpg

# --- Live CCTV (IP 카메라 RTSP 직결, /cctv/live · /cctv/live/frame) ---
# Shared Dir 준비 전, IP 카메라 RTSP 를 서버에서 디코딩해 MJPEG 로 중계한다.
# KIOSK_CCTV_RTSP_URL 을 직접 주면 그 값을 그대로 사용하고, 비워두면 아래
# 구성요소로 rtsp://user:pass@host:port/path 를 조립한다.
# ⚠ 실제 비밀번호는 여기(.env.example)가 아니라 본인 .env 에만 둘 것.
KIOSK_CCTV_RTSP_URL=
KIOSK_CCTV_HOST=172.16.0.243
KIOSK_CCTV_PORT=554
KIOSK_CCTV_USER=admin
KIOSK_CCTV_PASSWORD=ekthf123
KIOSK_CCTV_STREAM_PATH=stream1
KIOSK_CCTV_JPEG_QUALITY=80
KIOSK_CCTV_RECONNECT_DELAY=3.0
KIOSK_CCTV_STREAM_FPS=20

# --- Shared DB (real MySQL/MariaDB written by kiosk-hardware) ---
# 서버 기동 시 이 DB에 연결한다. 미연결이면 부팅이 실패한다(폴백 없음).
# ⚠ 실제 비밀번호는 여기(.env.example)에 적지 말고 본인 .env 에만 둘 것.
KIOSK_DB_HOST=127.0.0.1
KIOSK_DB_PORT=3306
KIOSK_DB_USER=root
KIOSK_DB_PASSWORD=
KIOSK_DB_NAME=dasol
KIOSK_DB_CHARSET=utf8mb4
KIOSK_DB_CONNECT_TIMEOUT=5

# Static labels for fields the ERD has no column for (temp-humid / watch).
KIOSK_SITE_LOCATION=경기도 고양시
KIOSK_WATCH_REGION=고양시사업장

# --- TTS (Edge TTS) ---
KIOSK_TTS_VOICE=ko-KR-SunHiNeural
KIOSK_TTS_OUTPUT_DIR=./tts_out
# When true, synthesize real audio bytes via edge-tts; when false, stub only.
KIOSK_TTS_ENABLED=true

# --- Warning light (경광등) count -> control-signal thresholds ---
# ⚠ 아래 4개는 *초기 시드값*일 뿐이다. 실제 기준치는 런타임에 아래
# KIOSK_LIGHT_THRESHOLD_FILE(JSON)에 저장되며, 키오스크 [기준치] 패널이
# PUT /led/thresholds 로 그 파일을 갱신한다(신호등 UI와 실물 경광등이 값 공유).
# 이 .env 값은 JSON 파일이 아직 없을 때(최초 1회)만 사용된다.
# count 기준(기본): 0~9 소등 / 10~19 관심(초록) / 20~39 주의(노랑) / 40~49 경고(빨강) / 50+ 위험(점멸)
# 단, 경광등은 해당 사이클에 VLM 탐지가 있을 때만 발동(카운트 단독으로는 X).
KIOSK_LIGHT_INTEREST_THRESHOLD=10
KIOSK_LIGHT_CAUTION_THRESHOLD=20
KIOSK_LIGHT_WARNING_THRESHOLD=40
KIOSK_LIGHT_DANGER_THRESHOLD=50
# 런타임 기준치를 영속화하는 JSON 파일(단일 소스). 기본값 사용 시 생략 가능.
KIOSK_LIGHT_THRESHOLD_FILE=./light_thresholds.json

# --- Logging ---
KIOSK_LOG_LEVEL=INFO
